{
  "name": "opencode-stats",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ci": "bun run ci:checks && bun run mutate && bun run verify-gates",
    "ci:checks": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run knip && bun run dup && bun run exceptions && bun run shape && bun run outdated",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint -c .oxlintrc.ts --type-aware --report-unused-disable-directives --deny-warnings",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "knip": "knip && knip --production --strict",
    "dup": "jscpd",
    "mutate": "stryker run",
    "exceptions": "bun run scripts/exceptions.ts",
    "shape": "bun run scripts/shape.ts",
    "outdated": "bun run scripts/outdated.ts",
    "verify-gates": "bun run scripts/verify-gates.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.3",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.0.3",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "lefthook": "2.1.15",
    "oxc-parser": "0.152.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-plugin-complexity": "3.0.1",
    "oxlint-tsgolint": "7.0.2003",
    "semver": "7.8.5",
    "turbo": "2.11.6",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "error"
    }
  },
  "patchedDependencies": {
    "@stryker-mutator/vitest-runner@10.0.0": "patches/@stryker-mutator%2Fvitest-runner@10.0.0.patch"
  }
}

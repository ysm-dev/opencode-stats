{
  "threshold": 0,
  "exitCode": 1,
  "minTokens": 50,
  "reporters": ["console"],
  "absolute": true,
  "gitignore": true,
  "pattern": "{packages/*/{src,tests,testing},scripts}/**/*.{ts,tsx}",
  "ignore": [
    "**/node_modules/**",
    "**/coverage/**",
    "**/dist/**",
    "**/.release/**",
    "**/.dev/**",
    "fixtures/**"
  ]
}

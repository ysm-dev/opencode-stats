{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/testing/shards.ts",
        "stryker.canary.config.js",
        "scripts/{exceptions,verify-gates,shape,outdated,contracts,dev,generate,commit-message,release,bundle-check,native-build,native-prepare,native-outdated,opencode-prepare}.ts"
      ],
      "project": ["scripts/**/*.{ts,tsx}", "*.{js,ts}"]
    },
    "packages/dashboard-server": {
      "entry": ["src/process.ts!", "src/**/*.contract.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}!", "!src/testing/**!", "!src/**/*.node.ts!"]
    },
    "packages/stats-store": {
      "entry": ["src/sync-worker.ts!", "src/testing/dev.ts", "src/**/*.contract.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}!", "!src/testing/**!", "!src/**/*.node.ts!"]
    },
    "packages/dashboard": {
      "entry": ["src/style.css!"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/opencode-stats": {
      "project": ["src/**/*.{ts,tsx}!", "testing/**/*.{ts,tsx}"]
    },
    "packages/e2e": {
      "entry": ["tests/**/*.test.{ts,tsx}"],
      "project": ["tests/**/*.{ts,tsx}"]
    }
  }
}

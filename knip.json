{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/{exceptions,verify-gates,shape,outdated,contracts,dev,commit-message}.ts"],
      "project": ["scripts/**/*.{ts,tsx}", "*.{js,ts}"]
    },
    "packages/dashboard-server": {
      "entry": ["src/process.ts!", "src/**/*.contract.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/dashboard": {
      "entry": ["src/style.css!"],
      "project": ["src/**/*.{ts,tsx,css}"]
    }
  }
}
